{
  // Webview project: Svelte 5 + DOM, bundled by Vite. Shares the strict
  // baseline with the extension host (../tsconfig.base.json). tsc/tsgo only
  // type-check the .ts files (they skip .svelte); svelte-check reads this
  // same config and additionally checks the .svelte components.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // explicit so tsc and tsgo agree on which globals-providing packages are in scope
    "types": ["vscode-webview", "vitest/globals", "@testing-library/jest-dom"],
    // to have warnings/errors of the Svelte compiler at the correct
    // position, enable source maps
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
