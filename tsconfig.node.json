{
  // Build/tooling config project: root-level and webview-ui config files, plus
  // bin/ scripts, that run directly under Node (loaded by Vite/Vitest or
  // executed by tsx; never bundled by esbuild). Not covered by tsconfig.json
  // (only includes src/**) or webview-ui/tsconfig.json (only includes
  // webview-ui/src/**).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    // bin/verifyThatLangsBuildsExist.ts reads the pinned CLI version from ../config.js
    "allowJs": true
  },
  "include": [
    "bin/verifyThatLangsBuildsExist.ts",
    "vitest.config.ts",
    "vitest.unit.config.ts",
    "webview-ui/vite.config.ts",
    "webview-ui/vitest.config.ts"
  ]
}
