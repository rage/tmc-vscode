{
  "name": "test-my-code",
  "displayName": "TestMyCode",
  "version": "3.5.3",
  "description": "TestMyCode extension for Visual Studio Code",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "Helsinki",
    "MOOC",
    "MOOC.fi",
    "TestMyCode",
    "tmc"
  ],
  "bugs": {
    "url": "https://github.com/rage/tmc-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rage/tmc-vscode.git"
  },
  "publisher": "moocfi",
  "main": "./dist/extension",
  "scripts": {
    "backend:start": "pnpm --filter tmc-vscode-mock-backend run start",
    "build": "node esbuild.mjs",
    "ci:all": "pnpm install --frozen-lockfile",
    "clean-local-rust-config": "cd backend && cd cli && rm -rf tmc-vscode_plugin",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:langs-schema": "node bin/generateLangsSchema.mjs",
    "install:all": "pnpm install",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint --max-warnings=0",
    "playwright-test": "pnpm run webview:build && pnpm run build && xvfb-maybe playwright test",
    "playwright-test-debug": "pnpm run webview:build && pnpm run build && xvfb-maybe playwright test --debug",
    "playwright-test:local": "cross-env NODE_ENV=development BACKEND=mockBackend pnpm run playwright-test",
    "prepare": "husky",
    "pretest:integration": "cross-env NODE_ENV=development BACKEND=mockBackend pnpm run build",
    "release": "./bin/publishRelease.sh",
    "setup-ultimate": "git clean -X -d -f && git submodule update --init && pnpm install && pnpm --filter tmc-vscode-mock-backend run setup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "node ./bin/runIntegrationTests.js",
    "test:playwright": "pnpm run playwright-test",
    "ci:test": "pnpm run test && pnpm run test:integration",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json && tsgo --noEmit -p tsconfig.integration.json && tsgo --noEmit -p webview-ui/tsconfig.json && tsgo --noEmit -p backend/tsconfig.json && tsgo --noEmit -p playwright/tsconfig.json && tsgo --noEmit -p tsconfig.node.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json && tsc --noEmit -p webview-ui/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p playwright/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "update-submodules": "git submodule foreach git pull origin master",
    "vendor:langs-openapi": "bash bin/updateLangsOpenapi.sh",
    "vendor:langs-schema": "bash bin/updateLangsSchema.sh",
    "vscode:prepublish": "cross-env NODE_ENV=production pnpm run build",
    "watch": "node esbuild.mjs --watch",
    "webview:build": "pnpm --filter tmc-vscode-svelte run build",
    "webview:start": "pnpm --filter tmc-vscode-svelte run dev"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "del": "^8.0.0",
    "fs-extra": "^11.2.0",
    "get-folder-size": "^5.0.0",
    "handlebars": "^4.7.8",
    "lodash": "^4.17.21",
    "systeminformation": "^5.23.5",
    "tree-kill": "^1.2.2",
    "ts-results": "^3.3.0",
    "undici": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/chai": "^5.0.0",
    "@types/chai-as-promised": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.7",
    "@types/node": "^24.5.0",
    "@types/tmp": "0.2.6",
    "@types/vscode": "~1.100.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.0.0",
    "chai": "^6.0.0",
    "chai-as-promised": "^8.0.0",
    "cross-env": "^10.0.0",
    "esbuild": "^0.28.0",
    "eslint-plugin-playwright": "^2.10.5",
    "glob": "^13.0.0",
    "husky": "^9.1.5",
    "jest-mock-vscode": "^4.12.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.0",
    "mocha": "^11.0.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tmp": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "xvfb-maybe": "^0.2.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "tmc.addNewCourse",
        "title": "Add New Course...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.changeTmcDataPath",
        "title": "Change TMC Data Path",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.cleanExercise",
        "title": "Clean Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.closeExercise",
        "title": "Close Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.courseDetails",
        "title": "Go To Course Details...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.downloadNewExercises",
        "title": "Download New Exercises For Course...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.downloadOldSubmission",
        "title": "Download Old Submission",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.login",
        "title": "Log In",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.logout",
        "title": "Log Out",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.myCourses",
        "title": "Display My Courses",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.settings",
        "title": "Settings",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.openTMCExercisesFolder",
        "title": "Open TMC Data Folder",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.pasteExercise",
        "title": "Send Exercise To TMC Paste",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.resetExercise",
        "title": "Reset Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.selectAction",
        "title": "Action Menu",
        "icon": {
          "dark": "resources/dark/menu.svg",
          "light": "resources/light/menu.svg"
        },
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showLogin",
        "title": "Show Login Menu",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showWelcome",
        "title": "Welcome",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.submitExercise",
        "title": "Submit Solution",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.switchWorkspace",
        "title": "Switch Course Workspace",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.testExercise",
        "title": "Run Tests",
        "icon": {
          "dark": "resources/dark/test.svg",
          "light": "resources/light/test.svg"
        },
        "category": "TestMyCode"
      },
      {
        "command": "tmc.updateExercises",
        "title": "Update Exercises",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.logs",
        "title": "Show Logs",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.debug",
        "title": "Show Debug View",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.wipe",
        "category": "TestMyCode",
        "title": "Wipe all extension data"
      },
      {
        "command": "tmc.viewInitializationErrorHelp",
        "title": "View initialization error help",
        "category": "TestMyCode"
      },
      {
        "command": "tmcTreeView.refreshCourses",
        "title": "Fetch Course Updates",
        "category": "TestMyCode",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "tmcView.activateEntry",
        "title": "Activate",
        "category": "TestMyCode"
      }
    ],
    "configuration": {
      "title": "TestMyCode",
      "properties": {
        "testMyCode.downloadOldSubmission": {
          "type": "boolean",
          "default": true,
          "description": "When downloading exercises, download your latest submission instead of the exercise template."
        },
        "testMyCode.hideMetaFiles": {
          "type": "boolean",
          "default": true,
          "description": "Hide exercise meta files that are not relevant for completing exercises."
        },
        "testMyCode.insiderVersion": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Insider version to test new features for the TestMyCode extension."
        },
        "testMyCode.logLevel": {
          "type": "string",
          "scope": "application",
          "default": "errors",
          "enum": [
            "none",
            "errors",
            "verbose"
          ],
          "enumDescriptions": [
            "No extension logging.",
            "Log only warning and error messages.",
            "Log info, warning and error messages."
          ]
        },
        "testMyCode.updateExercisesAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Download exercise updates automatically."
        },
        "testMyCode.javaHome": {
          "type": "string",
          "default": "",
          "description": "If set, the Java (JDK) version in this path is used for Java exercises."
        }
      }
    },
    "keybindings": [
      {
        "command": "tmc.closeExercise",
        "key": "ctrl+shift+c",
        "when": "test-my-code:WorkspaceActive"
      },
      {
        "command": "tmc.selectAction",
        "key": "ctrl+shift+a",
        "when": "test-my-code:WorkspaceActive"
      },
      {
        "command": "tmc.testExercise",
        "key": "ctrl+shift+t",
        "when": "test-my-code:WorkspaceActive"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tmc.addNewCourse",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.courseDetails",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadNewExercises",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadOldSubmission",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.login",
          "when": "test-my-code:LoggedIn == false"
        },
        {
          "command": "tmc.logout",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.myCourses",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.pasteExercise",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.resetExercise",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.showLogin",
          "when": "false"
        },
        {
          "command": "tmc.submitExercise",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.updateExercises",
          "when": "test-my-code:LoggedIn"
        },
        {
          "command": "tmc.viewInitializationErrorHelp",
          "when": "false"
        },
        {
          "command": "tmcTreeView.refreshCourses",
          "when": "false"
        },
        {
          "command": "tmcView.activateEntry",
          "when": "false"
        },
        {
          "command": "tmc.testExercise",
          "when": "test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.closeExercise",
          "when": "test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.cleanExercise",
          "when": "test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.debug",
          "when": "test-my-code:DebugMode"
        }
      ],
      "editor/title": [
        {
          "command": "tmc.selectAction",
          "group": "navigation@1",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.testExercise",
          "group": "navigation@0",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive"
        }
      ],
      "explorer/context": [
        {
          "command": "tmc.cleanExercise",
          "group": "TestMyCode@6",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.closeExercise",
          "group": "TestMyCode@3",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.downloadOldSubmission",
          "group": "TestMyCode@5",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.pasteExercise",
          "group": "TestMyCode@2",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.resetExercise",
          "group": "TestMyCode@4",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.submitExercise",
          "group": "TestMyCode@1",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.testExercise",
          "group": "TestMyCode@0",
          "when": "resourceScheme == file && test-my-code:WorkspaceActive"
        }
      ],
      "view/title": [
        {
          "command": "tmc.addNewCourse",
          "when": "view == tmcView && test-my-code:LoggedIn"
        },
        {
          "command": "tmcTreeView.refreshCourses",
          "when": "view == tmcView && test-my-code:LoggedIn",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "tmc": [
        {
          "id": "tmcView",
          "name": "Menu"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "title": "TestMyCode",
          "id": "tmc",
          "icon": "media/TMC.png"
        }
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:**/TMC-Readme.md"
  ],
  "icon": "media/TMC.png",
  "galleryBanner": {
    "color": "#ffab0e",
    "theme": "light"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24",
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.9.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TestMyCode runs exercise code and the TMC-langs CLI on files in the workspace."
    }
  }
}
