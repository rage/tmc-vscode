{
  "name": "tmc-vscode-svelte",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "check": "node -e \"require('node:fs').rmSync('.svelte-check',{recursive:true,force:true})\" && svelte-check --tsconfig ./tsconfig.json --tsgo && tsgo --noEmit -p tsconfig.node.json",
    "check:tsc": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "harness": "vite --config dev/vite.config.ts",
    "harness:build": "vite build --config dev/vite.config.ts",
    "test:a11y": "vite build --config dev/vite.config.ts && playwright test --project=a11y",
    "test:visual": "vite build --config dev/vite.config.ts && playwright test --project=visual",
    "themes:refresh": "xvfb-maybe -a -- node dev/refreshThemes.mjs"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.46-24",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/vscode-webview": "^1.57.5",
    "axe-core": "^4.14.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
