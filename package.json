{
  "name": "test-my-code",
  "displayName": "TestMyCode",
  "version": "3.5.3",
  "description": "TestMyCode extension for Visual Studio Code",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "Helsinki",
    "MOOC",
    "MOOC.fi",
    "TestMyCode",
    "tmc"
  ],
  "bugs": {
    "url": "https://github.com/rage/tmc-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rage/tmc-vscode.git"
  },
  "publisher": "moocfi",
  "main": "./dist/extension",
  "scripts": {
    "backend:start": "pnpm --dir backend run start",
    "build": "node esbuild.mjs",
    "check:svelte": "pnpm --dir webview-ui run check",
    "ci:all": "pnpm install --frozen-lockfile",
    "clean-local-rust-config": "cd backend && cd cli && rm -rf tmc-vscode_plugin",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:langs-schema": "node bin/generateLangsSchema.mjs",
    "install:all": "pnpm install",
    "lint": "oxlint --max-warnings=0 && knip",
    "lint:fix": "oxlint --fix",
    "playwright-test": "pnpm run webview:build && cross-env NODE_ENV=development BACKEND=mockBackend pnpm run build && xvfb-maybe -a -- playwright test",
    "playwright-test-debug": "pnpm run webview:build && cross-env NODE_ENV=development BACKEND=mockBackend pnpm run build && xvfb-maybe -a -- playwright test --debug",
    "prepare": "husky",
    "pretest:integration": "cross-env NODE_ENV=development BACKEND=mockBackend pnpm run build",
    "release": "./bin/publishRelease.sh",
    "setup-ultimate": "git clean -X -d -f && git submodule update --init && pnpm install && pnpm --dir backend run setup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "node ./bin/runIntegrationTests.js",
    "ci:test": "pnpm run test && pnpm run test:integration",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json && tsgo --noEmit -p tsconfig.integration.json && tsgo --noEmit -p webview-ui/tsconfig.json && tsgo --noEmit -p backend/tsconfig.json && tsgo --noEmit -p playwright/tsconfig.json && tsgo --noEmit -p tsconfig.node.json && pnpm run check:svelte",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json && tsc --noEmit -p webview-ui/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p playwright/tsconfig.json && tsc --noEmit -p tsconfig.node.json && pnpm --dir webview-ui run check:tsc",
    "update-submodules": "git submodule foreach git pull origin master",
    "vendor:langs-openapi": "bash bin/updateLangsOpenapi.sh",
    "vendor:langs-schema": "bash bin/updateLangsSchema.sh",
    "vscode:prepublish": "cross-env NODE_ENV=production pnpm run build",
    "watch": "node esbuild.mjs --watch",
    "webview:build": "pnpm --dir webview-ui run build",
    "webview:start": "pnpm --dir webview-ui run dev"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "fs-extra": "^11.2.0",
    "get-folder-size": "^5.0.0",
    "lodash": "^4.17.21",
    "tree-kill": "^1.2.2",
    "ts-results": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/chai": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.7",
    "@types/node": "^24.5.0",
    "@types/tmp": "0.2.6",
    "@types/vscode": "~1.100.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "chai": "^6.0.0",
    "cross-env": "^10.0.0",
    "del": "^8.0.0",
    "esbuild": "^0.28.0",
    "eslint-plugin-playwright": "^2.10.5",
    "glob": "^13.0.0",
    "husky": "^9.1.5",
    "jest-mock-vscode": "^4.12.0",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.0.0",
    "mocha": "^11.0.0",
    "ovsx": "^1.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tmp": "^0.2.7",
    "tsx": "^4.6.2",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "xvfb-maybe": "^0.2.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "tmc.addNewCourse",
        "title": "Add New Course...",
        "category": "TestMyCode",
        "icon": "$(add)"
      },
      {
        "command": "tmc.changeTmcDataPath",
        "title": "Move Exercises Folder...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.cleanExercise",
        "title": "Clean Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.closeExercise",
        "title": "Close Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.courseDetails",
        "title": "Go To Course Details...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.downloadNewExercises",
        "title": "Download New Exercises...",
        "category": "TestMyCode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tmc.downloadOldSubmission",
        "title": "Download Old Submission...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.logout",
        "title": "Log Out",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.myCourses",
        "title": "Show My Courses",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.openCourseWorkspace",
        "title": "Open Course Workspace",
        "icon": "$(folder-opened)",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.settings",
        "title": "Open Settings",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.openTMCExercisesFolder",
        "title": "Open Exercises Folder",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.pasteExercise",
        "title": "Share Exercise via Paste",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.removeCourse",
        "title": "Remove Course...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.resetExercise",
        "title": "Reset Exercise",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showAccountMenu",
        "title": "Show Account Actions...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showMoocLogin",
        "title": "Log In",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showExerciseActions",
        "title": "Show Exercise Actions...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.showWelcome",
        "title": "Get Started",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.submitExercise",
        "title": "Submit Solution",
        "category": "TestMyCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tmc.switchWorkspace",
        "title": "Switch Course Workspace...",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.testExercise",
        "title": "Run Tests",
        "icon": "$(beaker)",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.testing.submitExercise",
        "title": "Submit Solution",
        "category": "TestMyCode",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tmc.testing.pasteExercise",
        "title": "Share Exercise via Paste",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.updateExercises",
        "title": "Update Exercises",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.logs",
        "title": "Show Logs",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.debug",
        "title": "Show Logs (Debug)",
        "category": "TestMyCode"
      },
      {
        "command": "tmc.wipe",
        "category": "TestMyCode",
        "title": "Wipe All Extension Data..."
      },
      {
        "command": "tmc.viewInitializationErrorHelp",
        "title": "Show Initialization Error Help",
        "category": "TestMyCode"
      },
      {
        "command": "tmcTreeView.refreshCourses",
        "title": "Refresh Courses",
        "category": "TestMyCode",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "TestMyCode",
      "properties": {
        "testMyCode.downloadOldSubmission": {
          "type": "boolean",
          "default": true,
          "description": "When downloading exercises, download your latest submission instead of the exercise template.",
          "order": 0
        },
        "testMyCode.hideMetaFiles": {
          "type": "boolean",
          "default": true,
          "description": "Hide exercise meta files that are not relevant for completing exercises.",
          "order": 2
        },
        "testMyCode.logLevel": {
          "type": "string",
          "scope": "application",
          "default": "errors",
          "enum": [
            "none",
            "errors",
            "verbose"
          ],
          "enumDescriptions": [
            "No extension logging.",
            "Log only warning and error messages.",
            "Log info, warning and error messages."
          ],
          "order": 4,
          "description": "How much TestMyCode writes to its log, which Show Logs opens."
        },
        "testMyCode.updateExercisesAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Download exercise updates automatically.",
          "order": 1
        },
        "testMyCode.javaHome": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path to the JDK used for Java exercises, such as /usr/lib/jvm/java-21. Leave empty to use the Java found on your PATH.",
          "order": 3
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tmc.addNewCourse",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.courseDetails",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadNewExercises",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadOldSubmission",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.logout",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.myCourses",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.pasteExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.resetExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.showMoocLogin",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn == false"
        },
        {
          "command": "tmc.submitExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.updateExercises",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.viewInitializationErrorHelp",
          "when": "false"
        },
        {
          "command": "tmcTreeView.refreshCourses",
          "when": "false"
        },
        {
          "command": "tmc.testExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise"
        },
        {
          "command": "tmc.closeExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise"
        },
        {
          "command": "tmc.cleanExercise",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise"
        },
        {
          "command": "tmc.debug",
          "when": "test-my-code:DebugMode"
        },
        {
          "command": "tmc.changeTmcDataPath",
          "when": "test-my-code:Initialized"
        },
        {
          "command": "tmc.openTMCExercisesFolder",
          "when": "test-my-code:Initialized"
        },
        {
          "command": "tmc.wipe",
          "when": "test-my-code:Initialized"
        },
        {
          "command": "tmc.switchWorkspace",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.showWelcome",
          "when": "test-my-code:Initialized"
        },
        {
          "command": "tmc.openCourseWorkspace",
          "when": "false"
        },
        {
          "command": "tmc.removeCourse",
          "when": "test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.testing.submitExercise",
          "when": "false"
        },
        {
          "command": "tmc.testing.pasteExercise",
          "when": "false"
        },
        {
          "command": "tmc.showAccountMenu",
          "when": "false"
        },
        {
          "command": "tmc.showExerciseActions",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:ActiveEditorIsExercise"
        }
      ],
      "editor/title": [
        {
          "command": "tmc.testExercise",
          "group": "navigation@0",
          "when": "test-my-code:Initialized && test-my-code:ActiveEditorIsExercise"
        },
        {
          "command": "tmc.submitExercise",
          "group": "navigation@1",
          "when": "test-my-code:Initialized && test-my-code:ActiveEditorIsExercise && test-my-code:LoggedIn"
        }
      ],
      "explorer/context": [
        {
          "submenu": "tmc.exercise",
          "group": "testmycode",
          "when": "resourceScheme == file && test-my-code:Initialized && test-my-code:WorkspaceActive"
        }
      ],
      "tmc.exercise": [
        {
          "command": "tmc.testExercise",
          "group": "1_check@1",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.submitExercise",
          "group": "1_check@2",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.pasteExercise",
          "group": "1_check@3",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadOldSubmission",
          "group": "2_restore@1",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.resetExercise",
          "group": "2_restore@2",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.cleanExercise",
          "group": "3_close@1",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive"
        },
        {
          "command": "tmc.closeExercise",
          "group": "3_close@2",
          "when": "test-my-code:Initialized && test-my-code:WorkspaceActive"
        }
      ],
      "view/title": [
        {
          "command": "tmc.addNewCourse",
          "group": "navigation@1",
          "when": "view == tmcView && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmcTreeView.refreshCourses",
          "group": "navigation@2",
          "when": "view == tmcView && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.myCourses",
          "group": "1_courses@1",
          "when": "view == tmcView && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.openTMCExercisesFolder",
          "group": "1_courses@2",
          "when": "view == tmcView && test-my-code:Initialized"
        },
        {
          "command": "tmc.logout",
          "group": "2_account@1",
          "when": "view == tmcView && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.settings",
          "group": "3_help@1",
          "when": "view == tmcView"
        },
        {
          "command": "tmc.logs",
          "group": "3_help@2",
          "when": "view == tmcView"
        }
      ],
      "view/item/context": [
        {
          "command": "tmc.downloadNewExercises",
          "group": "inline@1",
          "when": "view == tmcView && viewItem =~ /\\.hasNew$/ && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.openCourseWorkspace",
          "group": "inline@2",
          "when": "view == tmcView && viewItem =~ /^course\\./ && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.courseDetails",
          "group": "1_course@1",
          "when": "view == tmcView && viewItem =~ /^course\\./ && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.openCourseWorkspace",
          "group": "1_course@2",
          "when": "view == tmcView && viewItem =~ /^course\\./ && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.downloadNewExercises",
          "group": "1_course@3",
          "when": "view == tmcView && viewItem =~ /\\.hasNew$/ && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.removeCourse",
          "group": "9_remove@1",
          "when": "view == tmcView && viewItem =~ /^course\\./ && test-my-code:Initialized && test-my-code:LoggedIn"
        }
      ],
      "testing/item/context": [
        {
          "command": "tmc.testing.submitExercise",
          "group": "1_testmycode@1",
          "when": "controllerId == tmc && test-my-code:Initialized && test-my-code:LoggedIn"
        },
        {
          "command": "tmc.testing.pasteExercise",
          "group": "1_testmycode@2",
          "when": "controllerId == tmc && test-my-code:Initialized && test-my-code:LoggedIn"
        }
      ]
    },
    "submenus": [
      {
        "id": "tmc.exercise",
        "label": "TestMyCode"
      }
    ],
    "views": {
      "tmc": [
        {
          "id": "tmcView",
          "name": "Courses"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tmcView",
        "when": "!test-my-code:Initialized && !test-my-code:Degraded",
        "contents": "Starting TestMyCode…\n[Show Logs](command:tmc.logs)"
      },
      {
        "view": "tmcView",
        "when": "test-my-code:Degraded",
        "contents": "TestMyCode could not start, so its courses and exercises are unavailable.\n[Show Details](command:tmc.viewInitializationErrorHelp)\n[Restart Extension Host](command:workbench.action.restartExtensionHost)\n[Show Logs](command:tmc.logs)"
      },
      {
        "view": "tmcView",
        "when": "test-my-code:Initialized && !test-my-code:LoggedIn",
        "contents": "Log in with your courses.mooc.fi account to download, test and submit exercises.\n[Log In](command:tmc.showMoocLogin)\n[Read the installation guide](https://www.mooc.fi/en/installation/vscode)"
      },
      {
        "view": "tmcView",
        "when": "test-my-code:Initialized && test-my-code:LoggedIn",
        "contents": "You have not added any courses yet.\n[Add a Course](command:tmc.addNewCourse)\n[Open My Courses](command:tmc.myCourses)"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with TestMyCode",
        "description": "Log in, add your course, and test and submit your first exercise.",
        "steps": [
          {
            "id": "logIn",
            "title": "Log in with courses.mooc.fi",
            "description": "Use your courses.mooc.fi account. Logging in opens courses.mooc.fi in your browser.\n[Log In](command:tmc.showMoocLogin)",
            "media": {
              "markdown": "media/walkthrough/log-in.md"
            },
            "completionEvents": [
              "onContext:test-my-code:LoggedIn"
            ]
          },
          {
            "id": "addCourse",
            "title": "Add a course",
            "description": "Pick the course you are taking.\n[Add a Course](command:tmc.addNewCourse)",
            "media": {
              "markdown": "media/walkthrough/add-course.md"
            },
            "completionEvents": [
              "onContext:test-my-code:HasCourses"
            ]
          },
          {
            "id": "openExercises",
            "title": "Download and open exercises",
            "description": "Download the course's exercises and open its workspace.\n[Show Course Details](command:tmc.courseDetails)\n[Open Course Workspace](command:tmc.openCourseWorkspace)",
            "media": {
              "markdown": "media/walkthrough/open-exercises.md"
            },
            "completionEvents": [
              "onContext:test-my-code:WorkspaceActive"
            ]
          },
          {
            "id": "runTests",
            "title": "Run the tests",
            "description": "Open a file of an exercise and run its tests on your computer.\n[Run Tests](command:tmc.testExercise)",
            "media": {
              "markdown": "media/walkthrough/run-tests.md"
            },
            "completionEvents": [
              "onCommand:tmc.testExercise"
            ]
          },
          {
            "id": "submit",
            "title": "Submit your solution",
            "description": "Send the exercise for grading to earn its points.\n[Submit Solution](command:tmc.submitExercise)",
            "media": {
              "markdown": "media/walkthrough/submit.md"
            },
            "completionEvents": [
              "onCommand:tmc.submitExercise"
            ]
          },
          {
            "id": "getHelp",
            "title": "Get help",
            "description": "Where to find instructions and report problems, and what data the extension sends.\n[Read the Installation Guide](https://www.mooc.fi/en/installation/vscode)\n[Show Logs](command:tmc.logs)",
            "media": {
              "markdown": "media/walkthrough/get-help.md"
            },
