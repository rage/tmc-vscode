{
  "name": "tmc-vscode-svelte",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "check": "node -e \"require('node:fs').rmSync('.svelte-check',{recursive:true,force:true})\" && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:tsc": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/vscode-webview": "^1.57.4",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^5.3.3",
    "vite": "^8.1.4"
  }
}
